# StackIT AI Assistant API Configuration
# Copy this file to .env and fill in your authentication details

# Option 1: Bearer token authentication
# STACKIT_AUTH_TOKEN=your_bearer_token_here

# Option 2: API Key authentication  
# STACKIT_API_KEY=your_api_key_here

# Option 3: Session ID
# STACKIT_SESSION_ID=your_session_id_here

# Custom headers (replace HEADER_NAME with actual header name, use underscores for dashes)
# Example: for "X-Custom-Header", use STACKIT_HEADER_X_CUSTOM_HEADER
# STACKIT_HEADER_X_CUSTOM_HEADER=value

# Common authentication headers you might need:
# STACKIT_HEADER_COOKIE=your_cookie_string
# STACKIT_HEADER_X_CSRF_TOKEN=your_csrf_token
# STACKIT_HEADER_USER_AGENT=Mozilla/5.0...
# STACKIT_HEADER_REFERER=https://assistant.demo.pre-prod.stackit.run